{% comment %}
  Loyalty Credits - Product Cashback Banner
  Shows the amount of store credit a customer earns by purchasing this product.
  Dynamically calculated from the product price and the configured percentages.
  Place this block on product pages in the theme editor.
{% endcomment %}

{% assign product_price = product.selected_or_first_available_variant.price | times: 1.0 %}
{% assign min_pct = block.settings.min_percentage | times: 1.0 %}
{% assign max_pct = block.settings.max_percentage | times: 1.0 %}

{% assign min_credit = product_price | times: min_pct | divided_by: 100.0 | divided_by: 100.0 %}
{% assign max_credit = product_price | times: max_pct | divided_by: 100.0 | divided_by: 100.0 %}

{% if product_price > 0 %}
  <div class="loyalty-cashback" style="
    background: {{ block.settings.bg_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    margin: 8px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  ">
    {% if block.settings.show_icon %}
      <span style="
        font-size: 24px;
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: {{ block.settings.accent_color }};
        color: {{ block.settings.bg_color }};
        border-radius: 50%;
        font-size: 16px;
      ">{{ block.settings.icon }}</span>
    {% endif %}

    <div style="flex: 1;">
      {% if min_pct == max_pct %}
        <p style="margin: 0; font-size: {{ block.settings.font_size }}px; font-weight: 600;">
          Earn {{ max_credit | money_without_trailing_zeros }} store credit
        </p>
        <p style="margin: 2px 0 0; font-size: {{ block.settings.font_size | minus: 2 }}px; opacity: 0.75;">
          {{ max_pct | divided_by: 100.0 }}% cashback on this purchase
        </p>
      {% else %}
        <p style="margin: 0; font-size: {{ block.settings.font_size }}px; font-weight: 600;">
          Earn {{ min_credit | money_without_trailing_zeros }} – {{ max_credit | money_without_trailing_zeros }} store credit
        </p>
        <p style="margin: 2px 0 0; font-size: {{ block.settings.font_size | minus: 2 }}px; opacity: 0.75;">
          {{ block.settings.subtext }}
        </p>
      {% endif %}
    </div>

    {% if block.settings.show_info_link and block.settings.info_url != blank %}
      <a href="{{ block.settings.info_url }}" style="
        color: {{ block.settings.accent_color }};
        font-size: 12px;
        text-decoration: underline;
        flex-shrink: 0;
      ">{{ block.settings.info_text }}</a>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Cashback",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Cashback percentages"
    },
    {
      "type": "number",
      "id": "min_percentage",
      "label": "Minimum tier percentage (x100)",
      "info": "Enter 500 for 5%, 700 for 7%, 1000 for 10%",
      "default": 500
    },
    {
      "type": "number",
      "id": "max_percentage",
      "label": "Maximum tier percentage (x100)",
      "info": "Enter 500 for 5%, 700 for 7%, 1000 for 10%",
      "default": 1000
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtitle text",
      "default": "Based on your loyalty tier. Spend more to earn more!"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f0fdf4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#166534"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#22c55e"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon emoji",
      "default": "★"
    },
    {
      "type": "header",
      "content": "Info link"
    },
    {
      "type": "checkbox",
      "id": "show_info_link",
      "label": "Show info link",
      "default": true
    },
    {
      "type": "text",
      "id": "info_text",
      "label": "Link text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "info_url",
      "label": "Link URL"
    }
  ]
}
{% endschema %}
