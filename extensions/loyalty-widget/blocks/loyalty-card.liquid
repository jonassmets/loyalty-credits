{% comment %}
  Loyalty Credits Card Block
  Full loyalty card with tier, balance, and progress.
  Every visual aspect is configurable in the theme editor.
{% endcomment %}

{% case block.settings.font_family %}
  {% when 'sans' %}{% assign ff = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" %}
  {% when 'serif' %}{% assign ff = "Georgia, 'Times New Roman', serif" %}
  {% when 'mono' %}{% assign ff = "'SF Mono', Menlo, monospace" %}
  {% when 'inherit' %}{% assign ff = "inherit" %}
{% endcase %}

{% if customer %}
  {% assign loyalty_balance = customer.metafields.loyalty_credits.balance.value | default: 0 %}
  {% assign loyalty_spent = customer.metafields.loyalty_credits.total_spent.value | default: 0 | times: 1.0 %}

  {% assign tier2_min = block.settings.tier2_min | times: 1.0 %}
  {% assign tier3_min = block.settings.tier3_min | times: 1.0 %}

  {% if loyalty_spent >= tier3_min %}
    {% assign tier_name = block.settings.tier3_name %}
    {% assign tier_pct = block.settings.tier3_cashback %}
    {% assign next_tier = blank %}
    {% assign progress = 100 %}
  {% elsif loyalty_spent >= tier2_min %}
    {% assign tier_name = block.settings.tier2_name %}
    {% assign tier_pct = block.settings.tier2_cashback %}
    {% assign next_tier = block.settings.tier3_name %}
    {% assign remaining = tier3_min | minus: loyalty_spent %}
    {% assign range = tier3_min | minus: tier2_min %}
    {% assign progress = loyalty_spent | minus: tier2_min | times: 100 | divided_by: range %}
  {% else %}
    {% assign tier_name = block.settings.tier1_name %}
    {% assign tier_pct = block.settings.tier1_cashback %}
    {% assign next_tier = block.settings.tier2_name %}
    {% assign remaining = tier2_min | minus: loyalty_spent %}
    {% assign range = tier2_min %}
    {% if range > 0 %}
      {% assign progress = loyalty_spent | times: 100 | divided_by: range %}
    {% else %}
      {% assign progress = 0 %}
    {% endif %}
  {% endif %}

  {% if progress > 100 %}{% assign progress = 100 %}{% endif %}
  {% if progress < 0 %}{% assign progress = 0 %}{% endif %}

  <div class="loyalty-card" style="
    background: {{ block.settings.bg_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ ff }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    position: relative;
    overflow: hidden;
    {% if block.settings.max_width > 0 %}max-width: {{ block.settings.max_width }}px; margin-left: auto; margin-right: auto;{% endif %}
  ">
    {% if block.settings.card_image != blank %}
      <div style="
        position: absolute; top: 0; right: 0; bottom: 0; width: 40%;
        opacity: {{ block.settings.image_opacity }};
        background-image: url('{{ block.settings.card_image | image_url: width: 600 }}');
        background-size: cover; background-position: center;
      "></div>
    {% endif %}

    <div style="position: relative; z-index: 1;">
      {% if block.settings.show_header %}
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
          <div>
            <p style="font-size: {{ block.settings.label_size }}px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin: 0 0 4px; color: {{ block.settings.accent_color }};">
              {{ block.settings.heading_text }}
            </p>
            <h3 style="font-size: {{ block.settings.heading_size }}px; font-weight: {{ block.settings.heading_weight }}; margin: 0; line-height: 1.2;">{{ tier_name }}</h3>
            <p style="font-size: {{ block.settings.body_size }}px; margin: 4px 0 0; opacity: 0.8;">
              You get {{ tier_pct }}% cashback on purchases
            </p>
          </div>
          {% if block.settings.show_balance %}
            <div style="text-align: right;">
              <p style="font-size: {{ block.settings.label_size }}px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin: 0 0 4px;">Balance</p>
              <p style="font-size: {{ block.settings.balance_size }}px; font-weight: 700; margin: 0; line-height: 1; color: {{ block.settings.accent_color }};">
                {{ loyalty_balance | money_without_trailing_zeros }}
              </p>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_progress %}
        <div style="margin-top: 16px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <div>
              <p style="font-size: {{ block.settings.label_size }}px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin: 0;">Spent (12 months)</p>
              <p style="font-size: {{ block.settings.body_size }}px; font-weight: 600; margin: 2px 0 0;">{{ loyalty_spent | money_without_trailing_zeros }}</p>
            </div>
            {% if next_tier != blank %}
              <div style="text-align: right;">
                <p style="font-size: {{ block.settings.label_size }}px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin: 0;">To reach {{ next_tier }}</p>
                <p style="font-size: {{ block.settings.body_size }}px; font-weight: 600; margin: 2px 0 0;">{{ remaining | money_without_trailing_zeros }}</p>
              </div>
            {% else %}
              <div style="text-align: right;">
                <p style="font-size: {{ block.settings.label_size }}px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin: 0;">Top tier</p>
                <p style="font-size: {{ block.settings.body_size }}px; font-weight: 600; margin: 2px 0 0;">Maximum cashback</p>
              </div>
            {% endif %}
          </div>

          <div style="background: {{ block.settings.progress_bg }}; border-radius: {{ block.settings.progress_radius }}px; height: {{ block.settings.progress_height }}px; overflow: hidden;">
            <div style="background: {{ block.settings.accent_color }}; height: 100%; width: {{ progress }}%; border-radius: {{ block.settings.progress_radius }}px; transition: width 0.3s;"></div>
          </div>

          {% if block.settings.show_tier_labels %}
            <div style="display: flex; justify-content: space-between; margin-top: 6px;">
              <div>
                <p style="font-size: {{ block.settings.label_size }}px; font-weight: 600; margin: 0;">{{ block.settings.tier1_name }}</p>
                <p style="font-size: {{ block.settings.label_size }}px; opacity: 0.7; margin: 0;">{{ block.settings.tier1_cashback }}%</p>
              </div>
              <div style="text-align: center;">
                <p style="font-size: {{ block.settings.label_size }}px; font-weight: 600; margin: 0;">{{ block.settings.tier2_name }}</p>
                <p style="font-size: {{ block.settings.label_size }}px; opacity: 0.7; margin: 0;">{{ block.settings.tier2_cashback }}%</p>
              </div>
              <div style="text-align: right;">
                <p style="font-size: {{ block.settings.label_size }}px; font-weight: 600; margin: 0;">{{ block.settings.tier3_name }}</p>
                <p style="font-size: {{ block.settings.label_size }}px; opacity: 0.7; margin: 0;">{{ block.settings.tier3_cashback }}%</p>
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_link and block.settings.link_text != blank %}
        <div style="margin-top: 16px;">
          <a href="{{ block.settings.link_url | default: '#' }}" style="color: {{ block.settings.accent_color }}; font-size: {{ block.settings.body_size }}px; text-decoration: underline;">
            {{ block.settings.link_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>

{% else %}
  {% if block.settings.show_guest_message %}
    <div style="
      background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};
      font-family: {{ ff }};
      border-radius: {{ block.settings.border_radius }}px;
      padding: {{ block.settings.padding }}px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
      text-align: center;
      {% if block.settings.max_width > 0 %}max-width: {{ block.settings.max_width }}px; margin-left: auto; margin-right: auto;{% endif %}
    ">
      <h3 style="font-size: {{ block.settings.heading_size }}px; font-weight: {{ block.settings.heading_weight }}; margin: 0 0 8px;">{{ block.settings.guest_heading }}</h3>
      <p style="font-size: {{ block.settings.body_size }}px; opacity: 0.8; margin: 0 0 8px;">{{ block.settings.guest_description }}</p>
      <p style="font-size: {{ block.settings.body_size }}px; margin: 0 0 16px; opacity: 0.7;">
        {{ block.settings.tier1_name }}: {{ block.settings.tier1_cashback }}% · {{ block.settings.tier2_name }}: {{ block.settings.tier2_cashback }}% · {{ block.settings.tier3_name }}: {{ block.settings.tier3_cashback }}%
      </p>
      <a href="{{ routes.account_login_url }}" style="
        display: inline-block;
        background: {{ block.settings.accent_color }};
        color: {{ block.settings.bg_color }};
        padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
        border-radius: {{ block.settings.button_radius }}px;
        text-decoration: none;
        font-weight: 600;
        font-size: {{ block.settings.body_size }}px;
      ">{{ block.settings.guest_button_text }}</a>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Loyalty Card",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Typography"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#00e676"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "progress_bg",
      "label": "Progress bar background",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "sans", "label": "Sans-serif" },
        { "value": "serif", "label": "Serif" },
        { "value": "mono", "label": "Monospace" }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 18,
      "max": 40,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label font size",
      "min": 9,
      "max": 14,
      "step": 1,
      "default": 11,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "balance_size",
      "label": "Balance font size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max width (0 = full)",
      "default": 0
    },
    {
      "type": "range",
      "id": "progress_height",
      "label": "Progress bar height",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "progress_radius",
      "label": "Progress bar radius",
      "min": 0,
      "max": 12,
      "step": 2,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image opacity",
      "min": 0.1,
      "max": 0.5,
      "step": 0.1,
      "default": 0.2
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show tier + balance header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_balance",
      "label": "Show balance",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tier_labels",
      "label": "Show tier labels under bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show link",
      "default": true
    },
    {
      "type": "header",
      "content": "Tiers (match your app)"
    },
    {
      "type": "text",
      "id": "tier1_name",
      "label": "Tier 1 name",
      "default": "Bronze"
    },
    {
      "type": "number",
      "id": "tier1_cashback",
      "label": "Tier 1 %",
      "default": 5
    },
    {
      "type": "text",
      "id": "tier2_name",
      "label": "Tier 2 name",
      "default": "Silver"
    },
    {
      "type": "number",
      "id": "tier2_cashback",
      "label": "Tier 2 %",
      "default": 7
    },
    {
      "type": "number",
      "id": "tier2_min",
      "label": "Tier 2 minimum spend",
      "default": 5000
    },
    {
      "type": "text",
      "id": "tier3_name",
      "label": "Tier 3 name",
      "default": "Gold"
    },
    {
      "type": "number",
      "id": "tier3_cashback",
      "label": "Tier 3 %",
      "default": 10
    },
    {
      "type": "number",
      "id": "tier3_min",
      "label": "Tier 3 minimum spend",
      "default": 10000
    },
    {
      "type": "header",
      "content": "Content & Labels"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading label",
      "default": "Loyalty Rewards"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "How to earn rewards"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Guest message & Button"
    },
    {
      "type": "checkbox",
      "id": "show_guest_message",
      "label": "Show for guests",
      "default": true
    },
    {
      "type": "text",
      "id": "guest_heading",
      "label": "Guest heading",
      "default": "Join our Loyalty Program"
    },
    {
      "type": "text",
      "id": "guest_description",
      "label": "Guest description",
      "default": "Earn store credit on every purchase. Sign in to view your balance."
    },
    {
      "type": "text",
      "id": "guest_button_text",
      "label": "Guest button text",
      "default": "Sign in"
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "label": "Button vertical padding",
      "min": 6,
      "max": 16,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "label": "Button horizontal padding",
      "min": 12,
      "max": 36,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 6,
      "unit": "px"
    }
  ]
}
{% endschema %}
