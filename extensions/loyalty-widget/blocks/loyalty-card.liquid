{% comment %}
  Loyalty Credits Card Block
  Full loyalty card with tier, balance, and progress.
  Tier thresholds and percentages are configurable in the theme editor.
{% endcomment %}

{% if customer %}
  {% assign loyalty_balance = customer.metafields.app.loyalty_total_earned.value | default: 0 %}
  {% assign loyalty_spent = customer.metafields.app.loyalty_total_spent.value | default: 0 | times: 1.0 %}

  {% comment %} Determine tier from configurable settings {% endcomment %}
  {% assign tier2_min = block.settings.tier2_min | times: 1.0 %}
  {% assign tier3_min = block.settings.tier3_min | times: 1.0 %}

  {% if loyalty_spent >= tier3_min %}
    {% assign tier_name = block.settings.tier3_name %}
    {% assign tier_pct = block.settings.tier3_pct %}
    {% assign next_tier = blank %}
    {% assign progress = 100 %}
  {% elsif loyalty_spent >= tier2_min %}
    {% assign tier_name = block.settings.tier2_name %}
    {% assign tier_pct = block.settings.tier2_pct %}
    {% assign next_tier = block.settings.tier3_name %}
    {% assign remaining = tier3_min | minus: loyalty_spent %}
    {% assign range = tier3_min | minus: tier2_min %}
    {% assign progress = loyalty_spent | minus: tier2_min | times: 100 | divided_by: range %}
  {% else %}
    {% assign tier_name = block.settings.tier1_name %}
    {% assign tier_pct = block.settings.tier1_pct %}
    {% assign next_tier = block.settings.tier2_name %}
    {% assign remaining = tier2_min | minus: loyalty_spent %}
    {% assign range = tier2_min %}
    {% assign progress = loyalty_spent | times: 100 | divided_by: range %}
  {% endif %}

  {% if progress > 100 %}{% assign progress = 100 %}{% endif %}
  {% if progress < 0 %}{% assign progress = 0 %}{% endif %}

  <div class="loyalty-card" style="
    background: {{ block.settings.bg_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 24px;
    position: relative;
    overflow: hidden;
  ">
    {% if block.settings.card_image != blank %}
      <div style="
        position: absolute; top: 0; right: 0; bottom: 0; width: 40%;
        opacity: 0.15;
        background-image: url('{{ block.settings.card_image | image_url: width: 600 }}');
        background-size: cover; background-position: center;
      "></div>
    {% endif %}

    <div style="position: relative; z-index: 1;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
        <div>
          <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin: 0 0 4px; color: {{ block.settings.accent_color }};">
            {{ block.settings.heading_text }}
          </p>
          <h3 style="font-size: 28px; font-weight: 700; margin: 0; line-height: 1.2;">{{ tier_name }}</h3>
          <p style="font-size: 13px; margin: 4px 0 0; opacity: 0.8;">
            You get {{ tier_pct }}% cashback on purchases
          </p>
        </div>
        <div style="text-align: right;">
          <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.8; margin: 0 0 4px;">Balance</p>
          <p style="font-size: 32px; font-weight: 700; margin: 0; line-height: 1; color: {{ block.settings.accent_color }};">
            {{ loyalty_balance | money_without_trailing_zeros }}
          </p>
        </div>
      </div>

      {% if block.settings.show_progress %}
        <div style="margin-top: 16px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <div>
              <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin: 0;">Spent (12 months)</p>
              <p style="font-size: 14px; font-weight: 600; margin: 2px 0 0;">{{ loyalty_spent | money_without_trailing_zeros }}</p>
            </div>
            {% if next_tier != blank %}
              <div style="text-align: right;">
                <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin: 0;">To reach {{ next_tier }}</p>
                <p style="font-size: 14px; font-weight: 600; margin: 2px 0 0;">{{ remaining | money_without_trailing_zeros }}</p>
              </div>
            {% else %}
              <div style="text-align: right;">
                <p style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin: 0;">Top tier</p>
                <p style="font-size: 14px; font-weight: 600; margin: 2px 0 0;">Maximum cashback</p>
              </div>
            {% endif %}
          </div>

          <div style="background: rgba(255,255,255,0.2); border-radius: 6px; height: 8px; overflow: hidden;">
            <div style="background: {{ block.settings.accent_color }}; height: 100%; width: {{ progress }}%; border-radius: 6px; transition: width 0.3s;"></div>
          </div>

          <div style="display: flex; justify-content: space-between; margin-top: 6px;">
            <div>
              <p style="font-size: 11px; font-weight: 600; margin: 0;">{{ block.settings.tier1_name }}</p>
              <p style="font-size: 11px; opacity: 0.7; margin: 0;">{{ block.settings.tier1_pct }}%</p>
            </div>
            <div style="text-align: center;">
              <p style="font-size: 11px; font-weight: 600; margin: 0;">{{ block.settings.tier2_name }}</p>
              <p style="font-size: 11px; opacity: 0.7; margin: 0;">{{ block.settings.tier2_pct }}%</p>
            </div>
            <div style="text-align: right;">
              <p style="font-size: 11px; font-weight: 600; margin: 0;">{{ block.settings.tier3_name }}</p>
              <p style="font-size: 11px; opacity: 0.7; margin: 0;">{{ block.settings.tier3_pct }}%</p>
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_link and block.settings.link_text != blank %}
        <div style="margin-top: 16px;">
          <a href="{{ block.settings.link_url }}" style="color: {{ block.settings.accent_color }}; font-size: 13px; text-decoration: underline;">
            {{ block.settings.link_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>

{% else %}
  {% if block.settings.show_guest_message %}
    <div style="
      background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};
      border-radius: {{ block.settings.border_radius }}px; padding: 24px; text-align: center;
    ">
      <h3 style="font-size: 20px; font-weight: 700; margin: 0 0 8px;">{{ block.settings.guest_heading }}</h3>
      <p style="font-size: 14px; opacity: 0.8; margin: 0 0 8px;">{{ block.settings.guest_description }}</p>
      <p style="font-size: 13px; margin: 0 0 16px; opacity: 0.7;">
        {{ block.settings.tier1_name }}: {{ block.settings.tier1_pct }}% · {{ block.settings.tier2_name }}: {{ block.settings.tier2_pct }}% · {{ block.settings.tier3_name }}: {{ block.settings.tier3_pct }}%
      </p>
      <a href="{{ routes.account_login_url }}" style="
        display: inline-block; background: {{ block.settings.accent_color }}; color: {{ block.settings.bg_color }};
        padding: 10px 24px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 14px;
      ">Sign in</a>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Loyalty Card",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#00e676"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Tiers (match your app settings)"
    },
    {
      "type": "text",
      "id": "tier1_name",
      "label": "Tier 1 name",
      "default": "Bronze"
    },
    {
      "type": "text",
      "id": "tier1_pct",
      "label": "Tier 1 %",
      "default": "5"
    },
    {
      "type": "text",
      "id": "tier2_name",
      "label": "Tier 2 name",
      "default": "Silver"
    },
    {
      "type": "text",
      "id": "tier2_pct",
      "label": "Tier 2 %",
      "default": "7"
    },
    {
      "type": "number",
      "id": "tier2_min",
      "label": "Tier 2 minimum spend",
      "default": 5000
    },
    {
      "type": "text",
      "id": "tier3_name",
      "label": "Tier 3 name",
      "default": "Gold"
    },
    {
      "type": "text",
      "id": "tier3_pct",
      "label": "Tier 3 %",
      "default": "10"
    },
    {
      "type": "number",
      "id": "tier3_min",
      "label": "Tier 3 minimum spend",
      "default": 10000
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Loyalty Rewards"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show tier progress",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show link",
      "default": true
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "How to earn rewards"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Guest message"
    },
    {
      "type": "checkbox",
      "id": "show_guest_message",
      "label": "Show message for non-logged-in visitors",
      "default": true
    },
    {
      "type": "text",
      "id": "guest_heading",
      "label": "Guest heading",
      "default": "Join our Loyalty Program"
    },
    {
      "type": "text",
      "id": "guest_description",
      "label": "Guest description",
      "default": "Earn store credit on every purchase. Sign in to view your balance."
    }
  ]
}
{% endschema %}
