{% comment %}
  CreditClub - Floating Widget (App Embed)
  Fully configurable: colors, fonts, position, size, content — all via theme editor.
{% endcomment %}

{% assign t1_name = block.settings.tier1_name %}
{% assign t1_pct = block.settings.tier1_pct_x100 | times: 1.0 %}
{% assign t1_min = block.settings.tier1_min | times: 1.0 %}
{% assign t2_name = block.settings.tier2_name %}
{% assign t2_pct = block.settings.tier2_pct_x100 | times: 1.0 %}
{% assign t2_min = block.settings.tier2_min | times: 1.0 %}
{% assign t3_name = block.settings.tier3_name %}
{% assign t3_pct = block.settings.tier3_pct_x100 | times: 1.0 %}
{% assign t3_min = block.settings.tier3_min | times: 1.0 %}

{% assign current_tier_name = t1_name %}
{% assign current_pct = t1_pct %}
{% assign current_tier_idx = 0 %}
{% assign total_spent = 0 %}
{% assign next_tier_name = t2_name %}
{% assign next_tier_min = t2_min %}
{% assign next_tier_pct = t2_pct %}
{% assign progress_pct = 0 %}
{% assign to_next = t2_min %}

{% if customer %}
  {% assign total_spent = customer.metafields.creditclub.total_spent.value | default: 0 | times: 1.0 %}
  {% assign balance = customer.metafields.creditclub.balance.value | default: 0 | times: 1.0 %}

  {% if total_spent >= t3_min %}
    {% assign current_tier_name = t3_name %}
    {% assign current_pct = t3_pct %}
    {% assign current_tier_idx = 2 %}
    {% assign next_tier_name = "" %}
    {% assign progress_pct = 100 %}
    {% assign to_next = 0 %}
  {% elsif total_spent >= t2_min %}
    {% assign current_tier_name = t2_name %}
    {% assign current_pct = t2_pct %}
    {% assign current_tier_idx = 1 %}
    {% assign next_tier_name = t3_name %}
    {% assign next_tier_min = t3_min %}
    {% assign next_tier_pct = t3_pct %}
    {% assign range = t3_min | minus: t2_min %}
    {% assign done = total_spent | minus: t2_min %}
    {% if range > 0 %}
      {% assign progress_pct = done | times: 100.0 | divided_by: range %}
    {% endif %}
    {% assign to_next = t3_min | minus: total_spent %}
  {% else %}
    {% assign range = t2_min | minus: t1_min %}
    {% assign done = total_spent | minus: t1_min %}
    {% if range > 0 %}
      {% assign progress_pct = done | times: 100.0 | divided_by: range %}
    {% endif %}
    {% assign to_next = t2_min | minus: total_spent %}
  {% endif %}

  {% if progress_pct > 100 %}{% assign progress_pct = 100 %}{% endif %}
  {% if progress_pct < 0 %}{% assign progress_pct = 0 %}{% endif %}
  {% if to_next < 0 %}{% assign to_next = 0 %}{% endif %}
{% endif %}

{% case block.settings.font_family %}
  {% when 'sans' %}{% assign ff = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" %}
  {% when 'serif' %}{% assign ff = "Georgia, 'Times New Roman', serif" %}
  {% when 'mono' %}{% assign ff = "'SF Mono', Menlo, monospace" %}
  {% when 'inherit' %}{% assign ff = "inherit" %}
{% endcase %}

<div id="loyalty-embed" style="
  position: fixed;
  {{ block.settings.position }}: {{ block.settings.offset_x }}px;
  bottom: {{ block.settings.offset_y }}px;
  z-index: 9999;
  font-family: {{ ff }};
">
  <!-- Toggle button -->
  <button id="loyalty-embed-toggle" aria-label="Loyalty rewards" style="
    background: {{ block.settings.btn_bg }};
    color: {{ block.settings.btn_text }};
    border: {{ block.settings.btn_border_width }}px solid {{ block.settings.btn_border_color }};
    border-radius: {{ block.settings.btn_radius }}px;
    padding: {{ block.settings.btn_padding_y }}px {{ block.settings.btn_padding_x }}px;
    font-family: {{ ff }};
    font-size: {{ block.settings.btn_font_size }}px;
    font-weight: {{ block.settings.btn_font_weight }};
    cursor: pointer;
    box-shadow: {{ block.settings.shadow }};
    display: flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.2s;
  ">
    {% if block.settings.show_icon %}<span>{{ block.settings.icon }}</span>{% endif %}
    {% if customer %}
      <span>{{ block.settings.btn_logged_in_prefix }} {{ current_tier_name }} · {{ current_pct | divided_by: 100.0 }}%</span>
    {% else %}
      <span>{{ block.settings.btn_guest_text }}</span>
    {% endif %}
  </button>

  <!-- Panel -->
  <div id="loyalty-embed-panel" style="
    display: none;
    position: absolute;
    bottom: {{ block.settings.btn_padding_y | plus: block.settings.btn_font_size | plus: 20 }}px;
    {{ block.settings.position }}: 0;
    background: {{ block.settings.panel_bg }};
    color: {{ block.settings.panel_text }};
    border-radius: {{ block.settings.panel_radius }}px;
    padding: {{ block.settings.panel_padding }}px;
    min-width: {{ block.settings.panel_width }}px;
    max-width: {{ block.settings.panel_width }}px;
    border: {{ block.settings.panel_border_width }}px solid {{ block.settings.panel_border_color }};
    box-shadow: {{ block.settings.shadow }};
    font-family: {{ ff }};
  ">
    {% if customer %}
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
        <div>
          <div style="font-size: {{ block.settings.panel_label_size }}px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.6;">Your Tier</div>
          <div style="font-size: {{ block.settings.panel_heading_size }}px; font-weight: 800; color: {{ block.settings.accent_color }}; margin-top: 2px;">
            {{ current_tier_name }}
          </div>
        </div>
        {% if block.settings.show_balance %}
          <div style="text-align: right;">
            <div style="font-size: {{ block.settings.panel_label_size }}px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.6;">Balance</div>
            <div style="font-size: {{ block.settings.panel_heading_size | minus: 2 }}px; font-weight: 700; color: {{ block.settings.accent_color }}; margin-top: 2px;">
              {{ balance | money_without_trailing_zeros }}
            </div>
          </div>
        {% endif %}
      </div>

      <div style="font-size: {{ block.settings.panel_body_size }}px; margin-bottom: 16px;">
        You get <strong style="color: {{ block.settings.accent_color }};">{{ current_pct | divided_by: 100.0 }}%</strong> cashback on every purchase
      </div>

      {% if block.settings.show_progress %}
        {% if next_tier_name != blank %}
          <div style="margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; font-size: {{ block.settings.panel_label_size }}px; opacity: 0.6; margin-bottom: 6px;">
              <span>{{ total_spent | money_without_trailing_zeros }} spent</span>
              <span>{{ next_tier_name }} at {{ next_tier_min | money_without_trailing_zeros }}</span>
            </div>
            <div style="background: {{ block.settings.progress_bg }}; border-radius: {{ block.settings.progress_radius }}px; height: {{ block.settings.progress_height }}px; overflow: hidden;">
              <div style="width: {{ progress_pct }}%; height: 100%; background: {{ block.settings.accent_color }}; border-radius: {{ block.settings.progress_radius }}px; transition: width 0.4s ease;"></div>
            </div>
            <div style="font-size: {{ block.settings.panel_label_size }}px; opacity: 0.6; margin-top: 4px;">
              {{ to_next | money_without_trailing_zeros }} to {{ next_tier_name }} ({{ next_tier_pct | divided_by: 100.0 }}% back)
            </div>
          </div>
        {% else %}
          <div style="margin-bottom: 16px;">
            <div style="font-size: {{ block.settings.panel_label_size }}px; opacity: 0.6; margin-bottom: 6px;">Top tier reached!</div>
            <div style="background: {{ block.settings.progress_bg }}; border-radius: {{ block.settings.progress_radius }}px; height: {{ block.settings.progress_height }}px; overflow: hidden;">
              <div style="width: 100%; height: 100%; background: {{ block.settings.accent_color }}; border-radius: {{ block.settings.progress_radius }}px;"></div>
            </div>
          </div>
        {% endif %}
      {% endif %}

    {% else %}
      <div style="margin-bottom: 16px;">
        <div style="font-size: {{ block.settings.panel_label_size }}px; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.6;">{{ block.settings.guest_label }}</div>
        <div style="font-size: {{ block.settings.panel_heading_size | minus: 4 }}px; font-weight: 700; margin-top: 4px;">{{ block.settings.guest_heading }}</div>
      </div>
      <div style="font-size: {{ block.settings.panel_body_size }}px; opacity: 0.8; margin-bottom: 16px;">
        {{ block.settings.guest_description }}
      </div>
    {% endif %}

    {% if block.settings.show_tier_breakdown %}
      <div style="display: flex; gap: 4px; margin-bottom: 4px;">
        <div style="flex: 1; height: 3px; border-radius: 2px; background: {% if current_tier_idx >= 0 and customer %}{{ block.settings.tier1_color }}{% else %}{{ block.settings.progress_bg }}{% endif %};"></div>
        <div style="flex: 1; height: 3px; border-radius: 2px; background: {% if current_tier_idx >= 1 and customer %}{{ block.settings.tier2_color }}{% else %}{{ block.settings.progress_bg }}{% endif %};"></div>
        <div style="flex: 1; height: 3px; border-radius: 2px; background: {% if current_tier_idx >= 2 and customer %}{{ block.settings.tier3_color }}{% else %}{{ block.settings.progress_bg }}{% endif %};"></div>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
        <span style="font-size: {{ block.settings.panel_label_size | minus: 1 }}px; {% if current_tier_idx == 0 and customer %}color: {{ block.settings.tier1_color }}; font-weight: 700;{% else %}opacity: 0.5;{% endif %}">{{ t1_name }} {{ t1_pct | divided_by: 100.0 }}%</span>
        <span style="font-size: {{ block.settings.panel_label_size | minus: 1 }}px; {% if current_tier_idx == 1 and customer %}color: {{ block.settings.tier2_color }}; font-weight: 700;{% else %}opacity: 0.5;{% endif %}">{{ t2_name }} {{ t2_pct | divided_by: 100.0 }}%</span>
        <span style="font-size: {{ block.settings.panel_label_size | minus: 1 }}px; {% if current_tier_idx == 2 and customer %}color: {{ block.settings.tier3_color }}; font-weight: 700;{% else %}opacity: 0.5;{% endif %}">{{ t3_name }} {{ t3_pct | divided_by: 100.0 }}%</span>
      </div>
    {% endif %}

    {% unless customer %}
      <a href="{{ routes.account_login_url }}" style="
        display: block; text-align: center;
        background: {{ block.settings.accent_color }}; color: {{ block.settings.panel_bg }};
        padding: 10px 16px; border-radius: 8px;
        text-decoration: none; font-weight: 600; font-size: {{ block.settings.panel_body_size }}px;
      ">{{ block.settings.guest_cta_text }}</a>
    {% else %}
      {% if block.settings.link_url != blank %}
        <a href="{{ block.settings.link_url }}" style="
          display: block; text-align: center;
          background: {{ block.settings.accent_color }}; color: {{ block.settings.panel_bg }};
          padding: 10px 16px; border-radius: 8px;
          text-decoration: none; font-weight: 600; font-size: {{ block.settings.panel_body_size }}px;
        ">{{ block.settings.link_text }}</a>
      {% endif %}
    {% endunless %}
  </div>
</div>

<script>
  (function() {
    var toggle = document.getElementById('loyalty-embed-toggle');
    var panel = document.getElementById('loyalty-embed-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', function() {
        var open = panel.style.display !== 'none';
        panel.style.display = open ? 'none' : 'block';
        toggle.style.transform = open ? 'scale(1)' : 'scale(0.95)';
      });
      document.addEventListener('click', function(e) {
        if (!document.getElementById('loyalty-embed').contains(e.target)) {
          panel.style.display = 'none';
          toggle.style.transform = 'scale(1)';
        }
      });
    }
  })();
</script>

