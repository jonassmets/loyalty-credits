generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model LoyaltyLog {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  orderId    String?
  amount     Float
  type       String   // "purchase_credit", "flow_credit", "manual_credit", "redemption"
  note       String?
  createdAt  DateTime @default(now())

  @@unique([shop, orderId, type], name: "unique_order_credit")
  @@index([shop, customerId])
  @@index([shop, orderId])
}
