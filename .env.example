# ── Shopify app credentials (Partner Dashboard → jouw app → API credentials) ──
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Publieke HTTPS-URL van de app = je Cloudflare Tunnel hostname.
# Bv. https://credits.jouwdomein.be   (GEEN slash op het einde)
SHOPIFY_APP_URL=""

# ── PostgreSQL (draait als 'db' container, zie docker-compose.yml) ──
POSTGRES_USER="creditclub"
POSTGRES_PASSWORD=""        # kies een sterk wachtwoord
POSTGRES_DB="creditclub"
# DATABASE_URL wordt automatisch opgebouwd in docker-compose.yml uit bovenstaande.
# Draai je buiten Docker? Zet dan zelf:
#   DATABASE_URL="postgresql://creditclub:wachtwoord@localhost:5432/creditclub"

# ── Cloudflare Tunnel (enkel nodig wanneer je de tunnel start) ──
# Token uit: Cloudflare Zero Trust → Networks → Tunnels → (jouw tunnel) → connector-token
TUNNEL_TOKEN=""

# ── Optioneel ──
# APP_PORT=3000             # poort op de NAS waarop de app lokaal bereikbaar is
# SHOP_CUSTOM_DOMAIN=""     # alleen voor een custom shop-domein
