# Loyalty Credits — NAS-stack omgevingsvariabelen.
# Kopieer naar `.env` in de projectmap en vul in. NOOIT committen.

# ── Postgres (lokaal op de NAS) ──────────────────────────────────────────────
POSTGRES_PASSWORD=zet-een-sterk-wachtwoord

# ── Shopify-app (CreditClub) ─────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Publieke tunnel-URL van de app (= Shopify application_url + redirect-basis):
SHOPIFY_APP_URL=https://loyalty.kattenberg118.be
SCOPES=read_orders,write_orders,read_customers,write_customers,read_store_credit_accounts,write_store_credit_account_transactions

# ── shopify-loyalty-api (kleine Express-API) ─────────────────────────────────
SHOPIFY_SHOP=jouw-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ── Cloudflare-tunnel ────────────────────────────────────────────────────────
# Token van een tunnel die je in het Cloudflare-dashboard aanmaakt
# (Zero Trust → Networks → Tunnels → Create a tunnel → "cloudflared"). Daar map
# je ook de public hostnames naar de container-services:
#   loyalty.kattenberg118.be      → http://app:3000
#   loyalty-api.kattenberg118.be  → http://api:3000   (indien nodig)
TUNNEL_TOKEN=
